# imjini.com 랜딩 페이지 (순수 PHP)
# server_name을 명시해야 king-custom-domains(80 default_server)로 빠지지 않는다.
server {
    listen 80;
    listen [::]:80;
    server_name imjini.com www.imjini.com;

    root /var/www/imjini/public;
    index index.php;

    include snippets/imjini-headers.conf;

    error_page 404 /404.php;

    # 정적 파일 7일 캐시 (?v= 번호로 갱신)
    location / {
        expires 7d;
        try_files $uri $uri/ =404;
    }

    # 글꼴은 바뀌지 않는 파일이라 1년 캐시
    location ^~ /assets/fonts/ {
        expires 1y;
    }

    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /404.php {
        internal;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # 프로젝트 상세: /projects/linkr → project.php (주소의 linkr 를 PROJECT_SLUG 로 넘김)
    location ~ ^/projects/([a-z0-9-]+)$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/project.php;
        fastcgi_param PROJECT_SLUG $1;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ ^/projects/([a-z0-9-]+)/$ {
        return 301 /projects/$1;
    }

    location ~ ^/projects/?$ {
        return 301 /#projects;
    }

    # 그 외 PHP 파일은 실행하지 않음
    location ~ \.php$ { return 404; }

    location ~ /\.(?!well-known) { deny all; }
}
